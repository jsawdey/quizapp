# Settings for compose.yaml. Copy this file to .env (git-ignored) next to it.

# The database to serve: /data/clues.db (Jeopardy! clues, from
# tool/build_clue_db.py) or /data/trivia.db (tool/build_trivia_db.py). List
# both, separated by a comma, to serve both and switch in the app with the ⇄
# button; the first is the default:
#   QUIZ_DB=/data/clues.db,/data/trivia.db
QUIZ_DB=/data/clues.db

# The bearer token the API asks for. The web page asks for it once and
# remembers it; phone builds take it as QUESTION_API_TOKEN. Empty means none.
QUIZ_TOKEN=
